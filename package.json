{
  "name": "PatchMind",
  "displayName": "patchmind",
  "description": "Auto-generate tests and docs on save using LLM",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "patchmind.generatePrSummary",
        "title": "PatchMind: Generate Pull Request Summary"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/node-fetch": "^2.6.13",
    "@types/vscode": "^1.102.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@google/genai": "^1.12.0",
    "dotenv": "^17.2.1",
    "node-fetch": "^3.3.2"
  },
  "publisher": "CELin",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChingEnLin/patchmind.git"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "llm",
    "gemini",
    "pull-request",
    "git",
    "ai",
    "devops"
  ]
}
